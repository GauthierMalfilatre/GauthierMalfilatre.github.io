---
// Two columns from lg up: the sidebar stays put while the page's content scrolls. One column below.
import Base from "./Base.astro";
import Sidebar from "../components/Sidebar.astro";
import { site } from "../site.config";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** This page's path in each language (defaults to the home pages). */
  alternates?: Record<Lang, string>;
  /** The home page (see Sidebar.astro). */
  home?: boolean;
  /** The sidebar nav link to mark as current outside the home page, e.g. "#projects". */
  current?: string;
}

const { lang, title, description, alternates, home, current } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "fr" ? "en" : "fr";
---

<Base lang={lang} title={title} description={description} alternates={alternates}>
  <div class="mx-auto max-w-7xl px-4 md:px-8 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-16 lg:px-12">
    <Sidebar lang={lang} home={home} otherUrl={alternates?.[other]} current={current} />
    <div class="@container lg:py-14">
      <main>
        <slot />
      </main>
      <footer>
        <p class="border-t border-line py-8 text-sm text-muted lg:pb-0">
          © {new Date().getFullYear()} {site.name}. {t("footer.built")}
        </p>
      </footer>
    </div>
  </div>
</Base>
