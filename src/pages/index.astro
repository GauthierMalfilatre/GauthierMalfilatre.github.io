---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();

const link = "underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent";
---

<Base>
  <header class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 md:px-8">
    <a href="/" class="font-medium tracking-tight">{site.name}</a>
    <nav class="flex gap-6 text-sm text-muted">
      <a href="#projects" class="transition-colors hover:text-fg">Projects</a>
      <a href="#contact" class="transition-colors hover:text-fg">Contact</a>
    </nav>
  </header>

  <main class="mx-auto max-w-5xl px-4 md:px-8">
    <section class="grid items-center gap-10 pt-12 pb-20 md:grid-cols-[1fr_auto] md:gap-16 md:pt-24 md:pb-28">
      <div>
        <h1 class="reveal text-4xl leading-[1.05] font-semibold tracking-tighter md:text-6xl">
          {site.name}
        </h1>
        <p class="reveal mt-5 max-w-[50ch] text-lg leading-relaxed text-muted" style="--i: 1">
          {site.tagline}
        </p>
        <div class="reveal mt-8 flex flex-wrap gap-3" style="--i: 2">
          <a
            href="#projects"
            class="rounded-xl bg-fg px-5 py-2.5 text-sm font-medium text-bg transition-transform active:scale-[0.98]"
          >
            Projects
          </a>
          <a
            href={site.github}
            class="rounded-xl px-5 py-2.5 text-sm font-medium ring-1 ring-line transition-colors hover:bg-surface active:scale-[0.98]"
          >
            GitHub
          </a>
        </div>
      </div>
      <img
        src={site.avatar}
        alt={`Portrait of ${site.name}`}
        width="224"
        height="224"
        class="reveal order-first size-24 rounded-xl object-cover ring-1 ring-line md:order-none md:size-56"
        style="--i: 1"
      />
    </section>

    <section id="projects" class="scroll-mt-16 border-t border-line py-20 md:py-28">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Projects</h2>

      {
        projects.length === 0 ? (
          <p class="mt-6 text-muted">
            No projects yet. Add a Markdown file to <code class="font-mono text-sm">src/content/projects/</code>.
          </p>
        ) : (
          <ul class="mt-10 grid gap-x-8 gap-y-14 md:grid-cols-2">
            {projects.map((project, i) => {
              const { title, description, tags, url, repo, image, imageAlt } = project.data;
              const href = url ?? repo;
              const Tag = href ? "a" : "div";
              const featured = i === 0;
              return (
                <li class:list={[featured && "md:col-span-2"]}>
                  <Tag href={href} class="group block">
                    {image && (
                      <div class="overflow-hidden rounded-xl bg-surface ring-1 ring-line">
                        <img
                          src={image}
                          alt={imageAlt}
                          loading="lazy"
                          width={featured ? 1600 : 1200}
                          height={featured ? 700 : 900}
                          class:list={[
                            "w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]",
                            featured ? "aspect-[16/7]" : "aspect-[4/3]",
                          ]}
                        />
                      </div>
                    )}
                    <h3 class="mt-5 text-lg font-medium transition-colors group-hover:text-accent">{title}</h3>
                    <p class="mt-2 max-w-[60ch] leading-relaxed text-muted">{description}</p>
                    {tags.length > 0 && (
                      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-muted">
                        {tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </Tag>
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    <section id="contact" class="scroll-mt-16 border-t border-line py-20 md:py-28">
      <h2 class="max-w-[22ch] text-3xl leading-[1.1] font-semibold tracking-tighter md:text-5xl">
        Have a project or an opening in mind? Let's talk.
      </h2>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-lg">
        {site.email && <a href={`mailto:${site.email}`} class={link}>{site.email}</a>}
        <a href={site.github} class={link}>GitHub</a>
        {site.linkedin && <a href={site.linkedin} class={link}>LinkedIn</a>}
      </div>
    </section>
  </main>

  <footer class="mx-auto max-w-5xl px-4 md:px-8">
    <p class="border-t border-line py-8 text-sm text-muted">© {year} {site.name}. Built with Astro.</p>
  </footer>
</Base>
