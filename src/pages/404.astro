---
// 404: "4 [teacup] 4", the zero being a cup of tea with rising steam (still with reduced motion),
// while the site's rain keeps falling behind. French, with an English line; the requested path is
// filled in by a tiny script (the page is static).
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
---

<Base lang="fr" title={`Page introuvable | ${site.name}`} alternates={false}>
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col items-center justify-center px-4 py-16 text-center md:px-8">
    <p
      aria-label="404"
      class="font-soft reveal flex items-end justify-center gap-[0.06em] text-[7rem] leading-none font-medium tracking-tight text-fg md:text-[11rem]"
    >
      <span aria-hidden="true">4</span>
      <!-- The zero: a cup of tea on its saucer. Colors from the theme tokens. -->
      <svg aria-hidden="true" viewBox="0 0 120 130" class="h-[1.25em] w-auto">
        <g class="steam" fill="none" stroke="var(--color-muted)" stroke-width="3" stroke-linecap="round">
          <path d="M46 40c-6-7 6-11 0-18s6-11 0-18" style="--d: 0s" />
          <path d="M60 36c-6-7 6-11 0-18s6-11 0-18" style="--d: 1.1s" />
          <path d="M74 40c-6-7 6-11 0-18s6-11 0-18" style="--d: 0.55s" />
        </g>
        <ellipse cx="60" cy="116" rx="50" ry="9" fill="var(--tile-1)" />
        <ellipse cx="60" cy="113" rx="30" ry="4" fill="var(--color-brand-900)" opacity="0.12" />
        <path d="M96 64c17-2 19 22 1 25" fill="none" stroke="var(--color-brand-300)" stroke-width="7" stroke-linecap="round" />
        <path d="M22 56h76v6c0 26-15 48-38 48S22 88 22 62z" fill="var(--color-brand-300)" />
        <path d="M30 70c2 18 12 32 30 32" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity="0.35" />
        <ellipse cx="60" cy="56" rx="38" ry="8" fill="var(--color-brand-200)" />
        <ellipse cx="60" cy="57" rx="32" ry="5.5" fill="var(--color-brand-600)" />
        <ellipse cx="51" cy="56" rx="9" ry="1.6" fill="#fff" opacity="0.25" />
      </svg>
      <span aria-hidden="true">4</span>
    </p>

    <h1 class="reveal mt-8 max-w-[20ch] text-4xl text-balance leading-[1.1] font-medium tracking-tight md:text-5xl" style="--i: 1">
      Cette page est sortie <span class="text-accent italic">sous la pluie.</span>
    </h1>
    <p class="reveal mt-5 max-w-[46ch] text-lg leading-relaxed text-muted" style="--i: 2">
      Elle n’existe pas, ou plus. Le temps qu’elle revienne, le thé est encore chaud et le reste du site vous attend.
    </p>
    <p class="reveal mt-1 max-w-[46ch] leading-relaxed text-muted/80" lang="en" style="--i: 2">
      This page doesn’t exist. The tea’s still warm, and the rest of the site is right this way.
    </p>
    <p class="reveal mt-5 text-sm text-muted" style="--i: 3">
      Adresse demandée&nbsp;: <code data-path class="rounded-md bg-surface px-1.5 py-0.5 text-fg">/</code>
    </p>

    <div class="reveal mt-9 flex flex-wrap justify-center gap-3" style="--i: 4">
      <a href="/" class="btn-primary">
        <Icon name="arrow-left" />
        Retour à l’accueil
      </a>
      <a href="/#projects" class="btn-secondary">Voir les projets</a>
      <a href="/en/" lang="en" class="btn-secondary">English version</a>
    </div>
  </main>
</Base>

<style>
  /* Steam curls up off the tea and fades, each wisp on its own beat; it just hangs there with reduced motion. */
  .steam path {
    opacity: 0.45;
  }
  @media (prefers-reduced-motion: no-preference) {
    .steam path {
      opacity: 0;
      animation: steam 3.3s ease-in-out var(--d) infinite;
    }
  }
  @keyframes steam {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    40% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
</style>

<script>
  // Show the path that was requested, shortened if needed.
  const path = decodeURIComponent(location.pathname);
  const shown = path.length > 40 ? `${path.slice(0, 39)}…` : path;
  document.querySelectorAll("[data-path]").forEach((el) => (el.textContent = shown));
</script>
