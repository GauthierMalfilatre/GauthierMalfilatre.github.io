---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
---

<Base title={`Page not found | ${site.name}`}>
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col justify-center px-4 md:px-8">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tighter md:text-6xl">Page not found</h1>
    <a
      href="/"
      class="mt-8 w-fit rounded-xl bg-fg px-5 py-2.5 text-sm font-medium text-bg transition-transform active:scale-[0.98]"
    >
      Back home
    </a>
  </main>
</Base>
