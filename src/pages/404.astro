---
// 404: a quiet page that points back home, in French with an English line.
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
---

<Base lang="fr" title={`Page introuvable | ${site.name}`} alternates={false}>
  <main class="mx-auto flex min-h-dvh max-w-5xl flex-col justify-center px-4 py-16 md:px-8">
    <p class="text-sm font-semibold text-accent">Erreur 404</p>
    <h1 class="mt-3 max-w-[18ch] text-5xl leading-[1.05] font-medium tracking-tight md:text-7xl">
      Cette page est sortie <span class="text-accent italic">sous la pluie.</span>
    </h1>
    <p class="mt-6 max-w-[50ch] text-lg leading-relaxed text-muted">
      Elle n’existe pas, ou plus. Le reste du site vous attend au chaud.
    </p>
    <p class="mt-1 max-w-[50ch] leading-relaxed text-muted/80" lang="en">
      This page doesn’t exist. The rest of the site is warm and dry.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Retour à l’accueil</a>
      <a href="/en/" lang="en" class="btn-secondary">English version</a>
    </div>
  </main>
</Base>
