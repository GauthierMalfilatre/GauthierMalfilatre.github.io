---
import ContributionGraph from "./ContributionGraph.astro";
import DecodeText from "./DecodeText.astro";
import Icon from "./Icon.astro";
import RaisedTile from "./RaisedTile.astro";
import { site } from "../site.config";
import { l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = site.cv[lang] || site.cv.fr;
const cvIsFallback = !site.cv[lang];
---

<section class="grid items-center gap-10 pt-10 pb-20 md:grid-cols-[1fr_auto] md:gap-16 md:pt-20 md:pb-28">
  <div>
    <p
      class="reveal inline-flex items-center gap-2.5 rounded-lg bg-brand-600/10 px-3 py-1.5 text-sm text-accent ring-1 ring-brand-600/25"
    >
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-500 opacity-60 motion-reduce:hidden"
        ></span>
        <span class="relative size-2 rounded-full bg-brand-500"></span>
      </span>
      {l(site.availability, lang)}
    </p>
    <h1
      aria-label={site.name}
      data-text={site.name}
      class="quantum reveal mt-6 text-4xl leading-[1.05] font-semibold tracking-tighter md:text-6xl"
      style="--i: 1"
    >
      <DecodeText text={site.name} />
    </h1>
    <p class="reveal mt-5 max-w-[50ch] text-lg leading-relaxed text-muted" style="--i: 2">
      {l(site.tagline, lang)}
    </p>
    <div class="reveal mt-8 flex flex-wrap gap-3" style="--i: 3">
      <a href={cv} download hreflang={cvIsFallback ? "fr" : undefined} type="application/pdf" class="btn-primary">
        <Icon name="download-simple" />
        {t(cvIsFallback ? "cta.cvFallback" : "cta.cv")}
      </a>
      <a href="#contact" class="btn-secondary">{t("cta.contact")}</a>
    </div>
  </div>

  <!-- Photo and GitHub graph on raised tiles: side by side on mobile, stacked on desktop. -->
  <div class="reveal order-first flex items-center gap-5 md:order-none md:w-56 md:flex-col md:items-stretch md:gap-7" style="--i: 1">
    <RaisedTile class="w-fit shrink-0">
      <img
        src={site.avatar}
        alt={site.name}
        width="224"
        height="224"
        class="block size-24 rounded-xl object-cover ring-1 ring-brand-600/40 md:size-56"
      />
    </RaisedTile>
    <ContributionGraph lang={lang} class="flex-1 md:flex-none" />
  </div>
</section>
