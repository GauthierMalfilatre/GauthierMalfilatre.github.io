---
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "./Icon.astro";
import { site } from "../site.config";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "fr" ? "en" : "fr";
const links = [
  ["#about", t("nav.about")],
  ["#projects", t("nav.projects")],
  ["#journey", t("nav.journey")],
  ["#skills", t("nav.skills")],
  ["#contact", t("nav.contact")],
];
---

<header class="sticky top-0 z-20 border-b border-line/70 bg-bg/75 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-6 px-4 md:px-8">
    <a href={getRelativeLocaleUrl(lang)} class="flex items-center gap-2.5 font-medium tracking-tight">
      <span aria-hidden="true" class="size-2.5 bg-brand-600 shadow-[3px_3px_0_var(--color-lift)]"></span>
      {site.name}
    </a>
    <div class="flex items-center gap-6">
      <nav class="hidden gap-6 text-sm text-muted md:flex">
        {links.map(([href, label]) => <a href={href} class="transition-colors hover:text-accent">{label}</a>)}
      </nav>
      <div class="flex items-center gap-1">
        <a
          href={getRelativeLocaleUrl(other)}
          hreflang={other}
          lang={other}
          aria-label={t("lang.switch")}
          title={t("lang.switch")}
          class="rounded-lg px-2 py-1.5 font-mono text-xs text-muted uppercase transition-colors hover:bg-brand-600/10 hover:text-accent"
        >
          {other}
        </a>
        <!-- Pause/resume the Game of Life background (hidden with reduced motion: it is already still). -->
        <button
          type="button"
          data-life-toggle
          aria-pressed="false"
          aria-label={t("life.pause")}
          title={t("life.pause")}
          class="group rounded-lg p-2 text-muted transition-colors hover:bg-brand-600/10 hover:text-accent aria-pressed:text-accent motion-reduce:hidden"
        >
          <Icon name="pause" class="size-4 group-aria-pressed:hidden" />
          <Icon name="play" class="hidden size-4 group-aria-pressed:block" />
        </button>
        <button
          type="button"
          data-theme-toggle
          aria-label={t("theme.toggle")}
          title={t("theme.toggle")}
          class="rounded-lg p-2 text-muted transition-colors hover:bg-brand-600/10 hover:text-accent"
        >
          <Icon name="moon" class="size-4 dark:hidden" />
          <Icon name="sun" class="hidden size-4 dark:block" />
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Background pause, remembered per browser (read by LifeBackground.astro too).
  const lifeToggle = document.querySelector<HTMLButtonElement>("[data-life-toggle]");
  if (lifeToggle) {
    let paused = false;
    try {
      paused = localStorage.getItem("life-paused") === "1";
    } catch {}
    lifeToggle.setAttribute("aria-pressed", String(paused));
    lifeToggle.addEventListener("click", () => {
      paused = !paused;
      lifeToggle.setAttribute("aria-pressed", String(paused));
      try {
        localStorage.setItem("life-paused", paused ? "1" : "0");
      } catch {}
      document.dispatchEvent(new CustomEvent("background-pause", { detail: { paused } }));
    });
  }

  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  let switching = false;

  toggle?.addEventListener("click", () => {
    if (switching) return;
    const isDark = root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;
    const next = isDark ? "light" : "dark";
    const rect = toggle.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const apply = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      // Poke the background from the button: a glider heading down-left into the page (see LifeBackground.astro).
      document.dispatchEvent(new CustomEvent("background-poke", { detail: { x, y, dx: -1, dy: 1 } }));
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || !root.animate) return apply();
    switching = true;
    blackHole(x, y, next, apply).finally(() => (switching = false));
  });

  /**
   * The page falls into the new theme: a disc of its background grows from (x, y), edged by a glowing
   * accretion ring, the theme switches underneath, then the disc fades away. Styles in global.css.
   */
  async function blackHole(x: number, y: number, next: string, apply: () => void) {
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const disc = document.createElement("div");
    disc.className = "theme-hole";
    disc.dataset.to = next;
    const ring = document.createElement("div");
    ring.className = "theme-hole-ring";
    Object.assign(ring.style, {
      left: `${x - radius}px`,
      top: `${y - radius}px`,
      width: `${radius * 2}px`,
      height: `${radius * 2}px`,
    });
    document.body.append(disc, ring);
    const timing: KeyframeAnimationOptions = { duration: 700, easing: "cubic-bezier(0.65, 0, 0.35, 1)", fill: "forwards" };
    const grow = disc.animate({ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] }, timing);
    ring.animate({ transform: ["scale(0)", "scale(1)"], opacity: [1, 1, 0] }, timing);
    try {
      await grow.finished;
      apply();
      await disc.animate({ opacity: [1, 0] }, { duration: 300, easing: "ease-out", fill: "forwards" }).finished;
    } finally {
      disc.remove();
      ring.remove();
    }
  }
</script>
