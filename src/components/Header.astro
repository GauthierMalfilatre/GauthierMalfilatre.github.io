---
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "./Icon.astro";
import { site } from "../site.config";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "fr" ? "en" : "fr";
const links = [
  ["#about", t("nav.about")],
  ["#projects", t("nav.projects")],
  ["#journey", t("nav.journey")],
  ["#skills", t("nav.skills")],
  ["#contact", t("nav.contact")],
];
---

<header class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-6 px-4 md:px-8">
  <a href={getRelativeLocaleUrl(lang)} class="font-medium tracking-tight">{site.name}</a>
  <div class="flex items-center gap-6">
    <nav class="hidden gap-6 text-sm text-muted md:flex">
      {links.map(([href, label]) => <a href={href} class="transition-colors hover:text-fg">{label}</a>)}
    </nav>
    <div class="flex items-center gap-1">
      <a
        href={getRelativeLocaleUrl(other)}
        hreflang={other}
        lang={other}
        aria-label={t("lang.switch")}
        title={t("lang.switch")}
        class="rounded-lg px-2 py-1.5 font-mono text-xs text-muted uppercase transition-colors hover:bg-surface hover:text-fg"
      >
        {other}
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t("theme.toggle")}
        title={t("theme.toggle")}
        class="rounded-lg p-2 text-muted transition-colors hover:bg-surface hover:text-fg"
      >
        <Icon name="moon" class="size-4 dark:hidden" />
        <Icon name="sun" class="hidden size-4 dark:block" />
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const isDark = root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;
    const next = isDark ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
