---
import Columns from "../layouts/Columns.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Games from "./Games.astro";
import Journey from "./Journey.astro";
import Projects from "./Projects.astro";
import Skills from "./Skills.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Columns lang={lang} home>
  <About lang={lang} />
  <Contact lang={lang} />
  <Projects lang={lang} />
  <Journey lang={lang} />
  <Skills lang={lang} />
  <Games lang={lang} />
</Columns>
