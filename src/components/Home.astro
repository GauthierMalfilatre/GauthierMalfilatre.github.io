---
import Base from "../layouts/Base.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Games from "./Games.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Journey from "./Journey.astro";
import Projects from "./Projects.astro";
import Skills from "./Skills.astro";
import { site } from "../site.config";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang}>
  <Header lang={lang} />
  <main class="mx-auto max-w-5xl px-4 md:px-8">
    <Hero lang={lang} />
    <About lang={lang} />
    <Projects lang={lang} />
    <Journey lang={lang} />
    <Skills lang={lang} />
    <Games lang={lang} />
    <Contact lang={lang} />
  </main>
  <footer class="mx-auto max-w-5xl px-4 md:px-8">
    <p class="border-t border-line py-8 text-sm text-muted">
      © {new Date().getFullYear()} {site.name}. {t("footer.built")}
    </p>
  </footer>
</Base>
