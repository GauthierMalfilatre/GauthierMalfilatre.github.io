---
import { getEntry, render } from "astro:content";
import ContributionGraph from "./ContributionGraph.astro";
import SectionTitle from "./SectionTitle.astro";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const entry = await getEntry("about", lang);
const { Content } = entry ? await render(entry) : { Content: null };
---

<section id="about" class="scroll-mt-8 border-t border-line py-16 md:py-20 lg:first:border-t-0 lg:first:pt-0">
  <SectionTitle title={t("nav.about")} />
  <div
    class="mt-8 max-w-[65ch] space-y-5 text-lg leading-relaxed text-muted [&>p:first-child]:text-fg [&_strong]:text-fg"
  >
    {Content && <Content />}
  </div>
  <ContributionGraph lang={lang} class="mt-10 max-w-sm" />
</section>
