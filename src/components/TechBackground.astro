---
// Background "tech wave": every few seconds a wave starts in the top-left corner and
// lifts the grid squares it passes, then they dissolve back into the background.
// A click on the background starts a wave from that point, and any script can start one
// with document.dispatchEvent(new CustomEvent("tech-wave", { detail: { x, y } })).
// Idle between waves (no animation frames); off when the tab is hidden or the
// visitor prefers reduced motion. Colors come from the --fx-* variables in global.css.
---

<div aria-hidden="true" class="ambient-glow pointer-events-none fixed inset-0 -z-20"></div>
<canvas data-tech-bg aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 size-full"></canvas>

<script>
  const CELL = 34; // grid pitch, px
  const GAP = 6; // space between squares, px
  const SPEED = 750; // wave speed, px/s
  const BAND = 320; // wave thickness, px
  const RAGGED = 120; // random per-square delay, px: makes the wave front irregular
  const LIFT = 5; // max lift, px
  const FIRST_DELAY = 1200; // ms after load or tab focus
  const MIN_DELAY = 7000; // ms between automatic waves
  const MAX_DELAY = 12000;
  const MAX_WAVES = 4; // concurrent waves, so click spam stays cheap

  interface Wave {
    x: number;
    y: number;
    start: number;
    /** Distance to the farthest corner: the wave is over once its tail passes it. */
    reach: number;
  }

  function init(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let width = 0;
    let height = 0;
    let cols = 0;
    let rows = 0;
    let delays = new Float32Array(0); // per square, 0..1
    let glints = new Float32Array(0); // per square, 0..1, mostly low: a few squares flash brighter
    let colors = readColors();
    let waves: Wave[] = [];
    let frame = 0;
    let timer = 0;

    function readColors() {
      const style = getComputedStyle(document.documentElement);
      const read = (name: string) => style.getPropertyValue(name).trim();
      return {
        face: read("--fx-face"),
        edge: read("--fx-edge"),
        side: read("--fx-side"),
        strength: parseFloat(read("--fx-strength")) || 0.3,
      };
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(width / CELL) + 1;
      rows = Math.ceil(height / CELL) + 1;
      delays = Float32Array.from({ length: cols * rows }, () => Math.random());
      glints = Float32Array.from({ length: cols * rows }, () => Math.random() ** 4);
    }

    const travelled = (wave: Wave, now: number) => ((now - wave.start) / 1000) * SPEED;

    function draw(now: number) {
      waves = waves.filter((wave) => travelled(wave, now) - RAGGED - BAND < wave.reach);
      ctx.clearRect(0, 0, width, height);
      if (!waves.length) {
        frame = 0;
        return;
      }

      const fronts = waves.map((wave) => travelled(wave, now));
      const size = CELL - GAP;
      for (let row = 0; row < rows; row++) {
        const y = row * CELL;
        for (let col = 0; col < cols; col++) {
          const x = col * CELL;
          const i = row * cols + col;
          // Strongest of the waves crossing this square.
          let k = 0;
          for (let w = 0; w < waves.length; w++) {
            const distance = Math.hypot(x + CELL / 2 - waves[w].x, y + CELL / 2 - waves[w].y);
            // 0 when the wave reaches the square, 1 when it has passed.
            const p = (fronts[w] - distance - delays[i] * RAGGED) / BAND;
            // Sharp rise, slow fade.
            if (p > 0 && p < 1) k = Math.max(k, p < 0.15 ? p / 0.15 : (1 - (p - 0.15) / 0.85) ** 2);
          }
          if (k === 0) continue;

          const alpha = k * colors.strength;
          const lift = k * LIFT;
          const left = x + GAP / 2;
          const top = y + GAP / 2;
          // Shadow where the square sat, face lifted up-left: reads as a raised tile.
          ctx.globalAlpha = alpha * 0.9;
          ctx.fillStyle = colors.side;
          ctx.fillRect(left, top, size, size);
          ctx.globalAlpha = alpha * (0.55 + 0.45 * glints[i]);
          ctx.fillStyle = colors.face;
          ctx.fillRect(left - lift, top - lift, size, size);
          ctx.globalAlpha = Math.min(1, alpha * (1.2 + 1.5 * glints[i]));
          ctx.strokeStyle = colors.edge;
          ctx.strokeRect(left - lift + 0.5, top - lift + 0.5, size - 1, size - 1);
        }
      }
      ctx.globalAlpha = 1;
      frame = requestAnimationFrame(draw);
    }

    function spawn(x: number, y: number) {
      if (motion.matches || document.hidden) return;
      colors = readColors(); // the theme may have changed since the last wave
      const reach = Math.max(
        Math.hypot(x, y),
        Math.hypot(width - x, y),
        Math.hypot(x, height - y),
        Math.hypot(width - x, height - y),
      );
      waves.push({ x, y, start: performance.now(), reach });
      if (waves.length > MAX_WAVES) waves.shift();
      if (!frame) frame = requestAnimationFrame(draw);
    }

    function autoWave() {
      if (motion.matches || document.hidden) return;
      spawn(0, 0);
      const duration = ((Math.hypot(width, height) + RAGGED + BAND) / SPEED) * 1000;
      schedule(duration + MIN_DELAY + Math.random() * (MAX_DELAY - MIN_DELAY));
    }

    function schedule(delay: number) {
      clearTimeout(timer);
      timer = window.setTimeout(autoWave, delay);
    }

    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
      clearTimeout(timer);
      waves = [];
      ctx.clearRect(0, 0, width, height);
    }

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : schedule(FIRST_DELAY)));
    motion.addEventListener("change", () => (motion.matches ? stop() : schedule(FIRST_DELAY)));

    // A click on the page background (not on a link, button or field) starts a wave there.
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest("a, button, input, textarea, select, label, summary, [role='button']")) return;
      if (getSelection()?.toString()) return; // the end of a text selection, not a click
      spawn(event.clientX, event.clientY);
    });
    document.addEventListener("tech-wave", (event) => {
      const { x, y } = (event as CustomEvent<{ x: number; y: number }>).detail;
      spawn(x, y);
    });

    resize();
    schedule(FIRST_DELAY);
  }

  const canvas = document.querySelector<HTMLCanvasElement>("[data-tech-bg]");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) init(canvas, ctx);
</script>
