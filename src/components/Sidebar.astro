---
// The left column: who, what, how to reach me. Sticky and full height from lg up (it scrolls on its
// own if the screen is too short), a plain intro block above the sections on smaller screens.
// The nav marks the section being read with aria-current (script below).
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "./Icon.astro";
import RaisedTile from "./RaisedTile.astro";
import { site } from "../site.config";
import { l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "fr" ? "en" : "fr";
const cv = site.cv[lang] || site.cv.fr;
const cvIsFallback = !site.cv[lang];
const links = [
  ["#about", t("nav.about")],
  ["#projects", t("nav.projects")],
  ["#journey", t("nav.journey")],
  ["#skills", t("nav.skills")],
  ["#games", t("games.title")],
  ["#contact", t("nav.contact")],
];
const socials = [
  { href: site.github, label: "GitHub", icon: "github-logo" },
  { href: site.linkedin, label: "LinkedIn", icon: "linkedin-logo" },
  { href: `mailto:${site.email}`, label: site.email, icon: "envelope-simple" },
] as const;
const toolButton = "rounded-full p-2 text-muted transition-colors hover:bg-brand-600/10 hover:text-accent";
---

<header
  class="pt-8 pb-14 lg:sticky lg:top-0 lg:max-h-dvh lg:overflow-y-auto lg:py-14 lg:[scrollbar-width:thin]"
>
  <div class="reveal flex items-start justify-between gap-4">
    <RaisedTile class="w-fit shrink-0">
      <img
        src={site.avatar}
        alt={site.name}
        width="96"
        height="96"
        class="block size-20 rounded-2xl object-cover shadow-lg shadow-brand-900/15 md:size-24"
      />
    </RaisedTile>
    <div class="flex items-center gap-1">
      {
        socials.map((social) => (
          <a href={social.href} aria-label={social.label} title={social.label} class={toolButton}>
            <Icon name={social.icon} class="size-[18px]" />
          </a>
        ))
      }
      <span aria-hidden="true" class="mx-1 h-5 w-px bg-line"></span>
      <a
        href={getRelativeLocaleUrl(other)}
        hreflang={other}
        lang={other}
        aria-label={t("lang.switch")}
        title={t("lang.switch")}
        class="rounded-full px-2.5 py-1.5 text-xs font-bold text-muted uppercase transition-colors hover:bg-brand-600/10 hover:text-accent"
      >
        {other}
      </a>
      <button type="button" data-theme-toggle aria-label={t("theme.toggle")} title={t("theme.toggle")} class={toolButton}>
        <Icon name="moon" class="size-4 dark:hidden" />
        <Icon name="sun" class="hidden size-4 dark:block" />
      </button>
    </div>
  </div>

  <h1 class="reveal mt-7 text-5xl leading-[1.05] font-medium tracking-tight" style="--i: 1">
    <a href={getRelativeLocaleUrl(lang)}>{site.name}</a>
  </h1>
  <p class="reveal mt-4 max-w-[42ch] text-lg leading-relaxed text-muted" style="--i: 2">
    {l(site.tagline, lang)}
  </p>
  <p
    class="reveal mt-5 inline-flex items-center gap-2.5 rounded-full bg-brand-600/8 px-3.5 py-1.5 text-sm font-semibold text-accent ring-1 ring-brand-600/20"
    style="--i: 2"
  >
    <span class="relative flex size-2">
      <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-500 opacity-60 motion-reduce:hidden"
      ></span>
      <span class="relative size-2 rounded-full bg-brand-500"></span>
    </span>
    {l(site.availability, lang)}
  </p>
  <div class="reveal mt-6 flex flex-wrap gap-3" style="--i: 3">
    <a href={cv} download hreflang={cvIsFallback ? "fr" : undefined} type="application/pdf" class="btn-primary">
      <Icon name="download-simple" />
      {t(cvIsFallback ? "cta.cvFallback" : "cta.cv")}
    </a>
    <a href="#contact" class="btn-secondary">{t("cta.contact")}</a>
  </div>

  <!-- Section nav, desktop only: on smaller screens the sections simply follow. -->
  <nav aria-label={t("nav.label")} class="reveal mt-10 hidden lg:block" style="--i: 4">
    <ul>
      {
        links.map(([href, label]) => (
          <li>
            <a
              href={href}
              data-nav-link
              class="group flex w-fit items-center gap-4 py-1.5 text-sm font-semibold text-muted transition-colors hover:text-fg aria-[current=true]:text-accent"
            >
              <span
                aria-hidden="true"
                class="h-px w-8 bg-current transition-[width] duration-300 group-hover:w-14 group-aria-[current=true]:w-14"
              />
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Theme toggle: a slow cross-fade where supported (timing in global.css), an instant switch elsewhere.
  const root = document.documentElement;
  document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.addEventListener("click", () => {
    const isDark = root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;
    const next = isDark ? "light" : "dark";
    const apply = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || !document.startViewTransition) return apply();
    document.startViewTransition(apply);
  });

  // Active section: the last one whose top has passed 40% of the screen, or the last one at the very bottom.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")];
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);
  let queued = false;
  function markActive() {
    queued = false;
    const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    let active = atBottom ? sections.at(-1) : undefined;
    if (!active) for (const section of sections) if (section.getBoundingClientRect().top <= innerHeight * 0.4) active = section;
    for (const link of navLinks) link.setAttribute("aria-current", String(link.hash === `#${active?.id}`));
  }
  function queue() {
    if (!queued) requestAnimationFrame(markActive);
    queued = true;
  }
  addEventListener("scroll", queue, { passive: true });
  // Also once the layout has settled (fonts, images) and whenever the window changes size.
  addEventListener("resize", queue);
  addEventListener("load", queue);
  markActive();
</script>
