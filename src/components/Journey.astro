---
import Icon from "./Icon.astro";
import SectionTitle from "./SectionTitle.astro";
import { education, experience } from "../data/journey";
import { formatPeriod, l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = [
  { title: t("journey.experience"), entries: experience },
  { title: t("journey.education"), entries: education },
];
---

<section id="journey" class="scroll-mt-8 border-t border-line py-16 md:py-20 lg:first:border-t-0 lg:first:pt-0">
  <SectionTitle title={t("nav.journey")} />

  <div class="mt-12 grid gap-14 @3xl:grid-cols-2 @3xl:gap-12">
    {
      groups.map((group) => (
        <div>
          <h3 class="text-xl font-medium text-accent italic">{group.title}</h3>
          <!-- Timeline: a soft rail with a round node per entry. -->
          <ol class="mt-6 border-l border-brand-600/20">
            {group.entries.map((entry) => (
              <li class="reveal-on-scroll relative pb-10 pl-7 last:pb-0">
                <span
                  aria-hidden="true"
                  class="absolute top-1 -left-[5.5px] size-2.5 rounded-full bg-brand-400 ring-4 ring-bg"
                />
                <!-- Several periods: one per line on mobile, one line with separators from sm up. -->
                <p class="flex flex-col text-sm font-semibold text-accent sm:flex-row sm:flex-wrap sm:gap-x-2">
                  {entry.periods.map((period, i) => (
                    <span>
                      {i > 0 && <span class="hidden sm:inline">· </span>}
                      {formatPeriod(period.start, period.end, lang)}
                    </span>
                  ))}
                </p>
                <h4 class="mt-1.5 text-lg font-semibold">{l(entry.title, lang)}</h4>
                <p class="text-sm text-muted">
                  {entry.org} · {entry.location}
                  {entry.note && <span class="ml-2 text-xs">{l(entry.note, lang)}</span>}
                </p>
                <p class="mt-3 max-w-[65ch] leading-relaxed text-muted">{l(entry.summary, lang)}</p>
                {entry.highlight && (
                  <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-brand-600/8 px-3 py-1 text-sm font-semibold text-accent ring-1 ring-brand-600/20">
                    <Icon name="trophy" />
                    {l(entry.highlight, lang)}
                  </p>
                )}
                {entry.tags && (
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {entry.tags.map((tag) => (
                      <li class="chip">{tag}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>
