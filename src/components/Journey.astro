---
import Icon from "./Icon.astro";
import { education, experience } from "../data/journey";
import { formatPeriod, l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = [
  { title: t("journey.experience"), entries: experience },
  { title: t("journey.education"), entries: education },
];
---

<section id="journey" class="scroll-mt-16 border-t border-line py-20 md:py-28">
  <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{t("nav.journey")}</h2>

  {
    groups.map((group) => (
      <div class="mt-12">
        <h3 class="text-sm font-medium text-accent">{group.title}</h3>
        <ol class="mt-6 space-y-10">
          {group.entries.map((entry) => (
            <li class="grid gap-2 md:grid-cols-[13rem_1fr] md:gap-8">
              <p class="font-mono text-sm text-muted md:pt-0.5">{formatPeriod(entry.start, entry.end, lang)}</p>
              <div>
                <h4 class="font-medium">{l(entry.title, lang)}</h4>
                <p class="text-muted">
                  {entry.org} · {entry.location}
                </p>
                <p class="mt-3 max-w-[65ch] leading-relaxed text-muted">{l(entry.summary, lang)}</p>
                {entry.highlight && (
                  <p class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-accent">
                    <Icon name="trophy" />
                    {l(entry.highlight, lang)}
                  </p>
                )}
                {entry.tags && (
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {entry.tags.map((tag) => (
                      <li class="rounded-lg px-2 py-0.5 font-mono text-xs text-muted ring-1 ring-line">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</section>
