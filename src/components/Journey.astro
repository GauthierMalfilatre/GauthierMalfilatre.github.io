---
import Icon from "./Icon.astro";
import SectionTitle from "./SectionTitle.astro";
import { education, experience } from "../data/journey";
import { formatPeriod, l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = [
  { title: t("journey.experience"), entries: experience },
  { title: t("journey.education"), entries: education },
];
---

<section id="journey" class="scroll-mt-20 border-t border-line py-20 md:py-28">
  <SectionTitle>{t("nav.journey")}</SectionTitle>

  <div class="mt-12 grid gap-14 lg:grid-cols-2 lg:gap-12">
    {
      groups.map((group) => (
        <div>
          <h3 class="font-mono text-sm text-accent">{group.title}</h3>
          <!-- Timeline: a purple rail with a square node per entry. -->
          <ol class="mt-6 border-l border-brand-600/30">
            {group.entries.map((entry) => (
              <li class="relative pb-10 pl-7 last:pb-0">
                <span
                  aria-hidden="true"
                  class="absolute top-1 -left-[5.5px] size-2.5 bg-brand-600 shadow-[3px_3px_0_var(--color-lift)]"
                />
                <!-- Several periods: one per line on mobile, one line with separators from sm up. -->
                <p class="flex flex-col font-mono text-xs text-accent sm:flex-row sm:flex-wrap sm:gap-x-2">
                  {entry.periods.map((period, i) => (
                    <span>
                      {i > 0 && <span class="hidden sm:inline">· </span>}
                      {formatPeriod(period.start, period.end, lang)}
                    </span>
                  ))}
                </p>
                <h4 class="mt-1.5 font-medium">{l(entry.title, lang)}</h4>
                <p class="text-sm text-muted">
                  {entry.org} · {entry.location}
                </p>
                <p class="mt-3 max-w-[65ch] leading-relaxed text-muted">{l(entry.summary, lang)}</p>
                {entry.highlight && (
                  <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-brand-600/10 px-2.5 py-1 text-sm font-medium text-accent ring-1 ring-brand-600/25">
                    <Icon name="trophy" />
                    {l(entry.highlight, lang)}
                  </p>
                )}
                {entry.tags && (
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {entry.tags.map((tag) => (
                      <li class="chip">{tag}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>
