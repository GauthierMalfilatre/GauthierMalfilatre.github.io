---
// Content resting on a card slightly tilted behind it, like a photo on a pile of paper.
// The content itself should be opaque so the card only shows around its edge.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["relative", className]}>
  <div
    aria-hidden="true"
    class="absolute inset-0 translate-x-1.5 translate-y-2 rotate-3 rounded-2xl bg-brand-300/35 md:translate-x-2.5 md:translate-y-3"
  >
  </div>
  <div class="relative">
    <slot />
  </div>
</div>
