---
import Icon from "./Icon.astro";
import { site } from "../site.config";
import { l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = site.cv[lang] || site.cv.fr;
const cvIsFallback = !site.cv[lang];

const link = "link inline-flex items-center gap-2";
---

<section id="contact" class="scroll-mt-20 border-t border-line py-20 md:py-28">
  <h2 class="max-w-[22ch] text-3xl text-balance leading-[1.1] font-semibold tracking-tighter md:text-5xl">
    {t("contact.title")} <span class="text-accent">{t("contact.titleAccent")}</span>
  </h2>
  <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-muted">{l(site.lookingFor, lang)}</p>
  <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-4 text-lg">
    <li>
      <a href={`mailto:${site.email}`} class={link}><Icon name="envelope-simple" class="size-5 text-accent" />{site.email}</a>
    </li>
    <li>
      <a href={site.linkedin} class={link}><Icon name="linkedin-logo" class="size-5 text-accent" />LinkedIn</a>
    </li>
    <li>
      <a href={site.github} class={link}><Icon name="github-logo" class="size-5 text-accent" />GitHub</a>
    </li>
    <li>
      <a href={cv} download hreflang={cvIsFallback ? "fr" : undefined} type="application/pdf" class={link}>
        <Icon name="download-simple" class="size-5 text-accent" />
        {t(cvIsFallback ? "cta.cvFallback" : "cta.cv")}
      </a>
    </li>
  </ul>
</section>
