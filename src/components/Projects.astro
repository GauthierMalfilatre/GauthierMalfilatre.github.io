---
// Projects as rows, grouped by context. A project with a write-up or a gallery opens its own page
// (src/pages/projets/), and its whole row is clickable.
import Icon from "./Icon.astro";
import ProjectThumb from "./ProjectThumb.astro";
import SectionTitle from "./SectionTitle.astro";
import { getPageIds, getProjects, projectUrl } from "../lib/projects";
import { l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects();
const pageIds = await getPageIds();
const groups = [
  { title: t("projects.groupPersonal"), context: "personal" },
  { title: t("projects.groupSchool"), context: "school" },
]
  .map((group) => ({ ...group, entries: projects.filter((p) => p.data.context === group.context) }))
  .filter((group) => group.entries.length);
---

<section id="projects" class="scroll-mt-8 border-t border-line py-16 md:py-20 lg:first:border-t-0 lg:first:pt-0">
  <SectionTitle title={t("nav.projects")} />

  {
    groups.map((group) => (
      <div class="mt-10">
        <h3 class="text-xl font-medium text-accent italic">{group.title}</h3>
        <ul class="-mx-3 mt-3 space-y-1">
          {group.entries.map((project) => {
            const { data } = project;
            const url = pageIds.has(project.id) ? projectUrl(project.id, lang) : null;
            return (
              <li
                class:list={[
                  "reveal-on-scroll group relative flex gap-4 rounded-2xl p-3 transition-colors @md:gap-5",
                  url && "hover:bg-surface/80",
                ]}
              >
                <ProjectThumb project={project} index={projects.indexOf(project)} class="w-20 shrink-0 @md:w-32" />
                <div class="min-w-0 flex-1">
                  <h4 class="font-soft text-xl leading-snug font-medium">
                    {url ? (
                      // Stretched over the whole row; the row's other links sit above it (z-10).
                      <a href={url} class="inline-flex items-center gap-1.5 after:absolute after:inset-0 after:rounded-2xl">
                        {data.title}
                        <Icon
                          name="arrow-right"
                          class="size-4 text-accent transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
                        />
                      </a>
                    ) : (
                      data.title
                    )}
                  </h4>
                  <p class="text-sm text-muted">
                    {data.team === 1 ? t("projects.solo") : t("projects.team").replace("{n}", String(data.team))}
                  </p>
                  <p class="mt-2 max-w-[60ch] leading-relaxed text-muted">{l(data.description, lang)}</p>
                  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
                    <ul class="flex flex-wrap gap-1.5">
                      {data.tags.map((tag) => (
                        <li class="chip">{tag}</li>
                      ))}
                    </ul>
                    {data.links.map((link) => (
                      <a
                        href={link.url}
                        class="relative z-10 inline-flex items-center gap-1 text-sm font-semibold transition-colors hover:text-accent"
                      >
                        {link.label ? l(link.label, lang) : t("projects.link")}
                        <Icon name="arrow-up-right" class="size-3.5" />
                      </a>
                    ))}
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</section>
