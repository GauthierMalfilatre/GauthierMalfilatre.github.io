---
// Projects as rows, grouped by context. Each group shows its first project; the others fold into a
// <details> that opens below it. A project with a write-up or a gallery opens its own page
// (src/pages/projets/), and its whole row is clickable.
import Icon from "./Icon.astro";
import ProjectRow from "./ProjectRow.astro";
import SectionTitle from "./SectionTitle.astro";
import { CONTEXTS, getPageIds, getProjects, projectUrl } from "../lib/projects";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects();
const pageIds = await getPageIds();
const groupTitles = {
  personal: t("projects.groupPersonal"),
  school: t("projects.groupSchool"),
  grdf: t("projects.groupGrdf"),
};
const groups = CONTEXTS.map((context) => ({
  title: groupTitles[context],
  entries: projects.filter((p) => p.data.context === context),
})).filter((group) => group.entries.length);
const urlOf = (id: string) => (pageIds.has(id) ? projectUrl(id, lang) : null);
const moreLabel = (n: number) => t(n === 1 ? "projects.moreOne" : "projects.more").replace("{n}", String(n));
---

<section id="projects" class="scroll-mt-8 border-t border-line py-16 md:py-20 lg:first:border-t-0 lg:first:pt-0">
  <SectionTitle title={t("nav.projects")} />

  {
    groups.map(({ title, entries: [first, ...rest] }) => (
      <div class="mt-10">
        <h3 class="text-xl font-medium text-accent italic">{title}</h3>
        <ul class="-mx-3 mt-3">
          <ProjectRow project={first} lang={lang} url={urlOf(first.id)} index={projects.indexOf(first)} />
        </ul>
        {rest.length > 0 && (
          <details class="fold group/fold mt-1">
            <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-full px-3.5 py-1.5 text-sm font-semibold text-accent ring-1 ring-brand-600/20 transition-colors select-none hover:bg-brand-600/10 [&::-webkit-details-marker]:hidden">
              <span class="group-open/fold:hidden">{moreLabel(rest.length)}</span>
              <span class="hidden group-open/fold:inline">{t("projects.less")}</span>
              <Icon
                name="caret-down"
                class="size-3.5 transition-transform group-open/fold:rotate-180 motion-reduce:transition-none"
              />
            </summary>
            <ul class="-mx-3 mt-2 space-y-1">
              {rest.map((project) => (
                <ProjectRow project={project} lang={lang} url={urlOf(project.id)} index={projects.indexOf(project)} />
              ))}
            </ul>
          </details>
        )}
      </div>
    ))
  }
</section>
