---
// Mini GitHub contribution graph: the last 26 weeks, in the brand purple scale.
// The grid is right-aligned and clipped, so narrow layouts show only the most recent weeks.
import Icon from "./Icon.astro";
import RaisedTile from "./RaisedTile.astro";
import { getContributions } from "../lib/github";
import { site } from "../site.config";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
const username = site.github.replace(/\/+$/, "").split("/").pop() ?? "";
const data = await getContributions(username);

const WEEKS = 26;
let days = data?.days ?? [];
if (days.length) {
  // Start on the Sunday WEEKS - 1 weeks before the current week, so columns are whole weeks.
  const lastSunday = days.length - 1 - new Date(`${days[days.length - 1].date}T00:00:00Z`).getUTCDay();
  days = days.slice(Math.max(0, lastSunday - (WEEKS - 1) * 7));
}

const number = new Intl.NumberFormat(lang);
const dateFormat = new Intl.DateTimeFormat(lang, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const describe = (count: number, date: string) => {
  const key = count === 0 ? "github.dayNone" : count === 1 ? "github.dayOne" : "github.dayMany";
  return t(key)
    .replace("{n}", number.format(count))
    .replace("{date}", dateFormat.format(new Date(`${date}T00:00:00Z`)));
};
const summary = data ? t("github.total").replace("{n}", number.format(data.total)) : "";
---

{
  data && (
    <RaisedTile class={["min-w-0", className].filter(Boolean).join(" ")}>
      <a
        href={site.github}
        class="group block rounded-xl bg-surface p-3 ring-1 ring-brand-600/40 transition hover:ring-brand-600/70"
      >
        <p class="flex items-center gap-1.5 text-xs text-muted transition-colors group-hover:text-accent">
          <Icon name="github-logo" class="size-3.5 shrink-0" />
          <span class="truncate">{summary}</span>
        </p>
        <div
          role="img"
          aria-label={summary}
          class="mt-2.5 grid grid-flow-col grid-rows-7 auto-cols-[10px] justify-[unsafe_end] gap-[3px] overflow-hidden"
        >
          {days.map((day) => (
            <span
              class="size-[10px]"
              style={`background: var(--contrib-${day.level})`}
              title={describe(day.count, day.date)}
            />
          ))}
        </div>
      </a>
    </RaisedTile>
  )
}
