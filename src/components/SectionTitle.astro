---
// Section heading with a small round marker.

interface Props {
  title: string;
  class?: string;
}
const { title, class: className } = Astro.props;
---

<h2 class:list={["flex items-center gap-3 text-3xl font-medium tracking-tight md:text-4xl", className]}>
  <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-brand-400"></span>
  {title}
</h2>
