---
import Icon from "./Icon.astro";
import SectionTitle from "./SectionTitle.astro";
import { getGames } from "../lib/steam";
import { site } from "../site.config";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const games = await getGames(site.steam.profile);
---

<section id="games" class="scroll-mt-20 border-t border-line py-20 md:py-28">
  <SectionTitle title={t("games.title")} />
  <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-muted">{t("games.intro")}</p>
  {
    site.steam.profile && (
      <a
        href={site.steam.profile}
        class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent transition-colors hover:text-fg"
      >
        {t("games.profile")}
        <Icon name="arrow-up-right" class="size-3.5" />
      </a>
    )
  }

  <!-- Mobile: horizontal scroll. Desktop: one row of equal columns. -->
  <ul
    class="reveal-on-scroll -mx-4 mt-10 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:thin] md:mx-0 md:grid md:grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] md:overflow-visible md:px-0 md:pb-0"
  >
    {
      games.map((game) => {
        const Tag = game.url ? "a" : "div";
        return (
          <li class="w-40 shrink-0 snap-start md:w-auto">
            <Tag href={game.url ?? undefined} class="group block">
              <div class="lift aspect-[2/3] overflow-hidden rounded-xl bg-surface ring-1 ring-line group-hover:ring-brand-600/60">
                {game.cover ? (
                  <img
                    src={game.cover}
                    alt=""
                    loading="lazy"
                    width="600"
                    height="900"
                    class="size-full object-cover"
                  />
                ) : (
                  <div class="flex size-full items-end bg-accent/10 p-4 font-medium">{game.name}</div>
                )}
              </div>
              <h3 class="mt-3 line-clamp-2 text-sm font-medium transition-colors group-hover:text-accent" title={game.name}>
                {game.name}
              </h3>
              {game.achievements && (
                <p class="mt-1 font-mono text-xs text-muted">
                  {t("games.achievements")
                    .replace("{unlocked}", String(game.achievements.unlocked))
                    .replace("{total}", String(game.achievements.total))}
                </p>
              )}
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>
