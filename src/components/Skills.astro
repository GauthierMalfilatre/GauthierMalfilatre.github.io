---
import SectionTitle from "./SectionTitle.astro";
import { skillGroups, spokenLanguages } from "../data/skills";
import { getDuolingoStats } from "../lib/duolingo";
import { site } from "../site.config";
import { l, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const languagesTitle = lang === "fr" ? "Langues" : "Languages";
const number = new Intl.NumberFormat(lang);

const languages = await Promise.all(
  spokenLanguages.map(async (language) => {
    const stats = language.duolingo ? await getDuolingoStats(site.duolingo.username, language.duolingo) : null;
    if (!stats) return { ...language, duolingo: null };
    const parts = [t("duolingo.xp").replace("{xp}", number.format(stats.xp))];
    if (stats.streak > 0) {
      parts.push(
        stats.streak === 1 ? t("duolingo.streakOne") : t("duolingo.streak").replace("{n}", number.format(stats.streak)),
      );
    }
    return {
      ...language,
      duolingo: { text: parts.join(", "), url: `https://www.duolingo.com/profile/${stats.username}` },
    };
  }),
);

const panel = "rounded-xl p-6 ring-1 backdrop-blur-sm";
---

<section id="skills" class="scroll-mt-20 border-t border-line py-20 md:py-28">
  <SectionTitle>{t("nav.skills")}</SectionTitle>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {
      skillGroups.map((group, i) => (
        <div class:list={[panel, i === 0 ? "bg-brand-600/12 ring-brand-600/35" : "bg-surface/70 ring-line"]}>
          <h3 class="text-sm font-medium text-muted">{l(group.title, lang)}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="chip px-2.5 py-1 text-sm">{l(item, lang)}</li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class:list={[panel, "bg-surface/70 ring-line"]}>
      <h3 class="text-sm font-medium text-muted">{languagesTitle}</h3>
      <dl class="mt-4 space-y-2">
        {
          languages.map((language) => (
            <div class="flex flex-wrap gap-x-3">
              <dt class="font-medium">{l(language.name, lang)}</dt>
              <dd class="text-muted">{l(language.level, lang)}</dd>
              {language.duolingo && (
                <dd class="w-full text-sm text-muted">
                  <a href={language.duolingo.url} class="link">
                    {language.duolingo.text}
                  </a>
                </dd>
              )}
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
