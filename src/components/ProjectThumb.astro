---
// A project's cover, or without one, its initial on a soft colored tile (four tones, see --tile-* in
// global.css), like a row of book spines.
import { Image } from "astro:assets";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  /** Picks the tile tone when there is no cover. */
  index: number;
  class?: string;
}

const { project, index, class: className } = Astro.props;
const { cover, title } = project.data;
const tone = (index % 4) + 1;
---

{
  cover ? (
    <Image
      src={cover}
      alt=""
      widths={[160, 320]}
      sizes="160px"
      class:list={["aspect-[4/3] rounded-xl object-cover ring-1 ring-line", className]}
    />
  ) : (
    <div
      aria-hidden="true"
      class:list={["font-soft flex aspect-[4/3] items-center justify-center rounded-xl text-4xl italic", className]}
      style={`background: var(--tile-${tone}); color: var(--tile-${tone}-ink)`}
    >
      {title.charAt(0)}
    </div>
  )
}
